---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
  noindex?: boolean;
}
const { title, heading, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs items={[{ name: heading }]} />
    <article class="prose prose-stone mt-6 max-w-none">
      <h1 class="">{heading}</h1>
      <slot />
    </article>
  </div>
</BaseLayout>
