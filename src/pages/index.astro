---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryGrid from '../components/StoryGrid.astro';
import ContinueReading from '../components/ContinueReading.astro';
import { SITE } from '../site.config';
import { getStories } from '../lib/content';

// Truyện mới đăng nhất lên đầu
const stories = await getStories();
const pageItems = stories.slice(0, SITE.storiesPerPage);
const next = stories.length > SITE.storiesPerPage ? '/page/2/' : undefined;
---

<BaseLayout title={`${SITE.name} – ${SITE.tagline}`} description={SITE.description} next={next}>
  <StoryGrid heading="Recent Stories" subheading={`New chapters and complete serial stories from ${SITE.name}, free to read.`} stories={pageItems} next={next}>
    <ContinueReading />
  </StoryGrid>
</BaseLayout>
