---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../site.config';
import { GENRES, genreUrl, getStories, slugify, tagUrl } from '../lib/content';

const stories = await getStories();
const count = (id: string) => stories.filter((s) => s.data.genres.includes(id)).length;
const tags = [...new Set(stories.flatMap((s) => s.data.tags))].sort();
---

<BaseLayout title={`Story Genres & Tags | ${SITE.name}`} description={`Browse ${SITE.name} stories by genre and tag: mafia romance, billionaire, family drama, revenge and more.`}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs items={[{ name: 'Genres' }]} />
    <h1 class="mb-6 mt-4 text-3xl font-bold">Genres</h1>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        GENRES.map((g) => (
          <a href={genreUrl(g.id)} class="rounded-xl border border-zinc-200 bg-white p-5 hover:border-accent">
            <h2 class=" text-xl font-bold">{g.name}</h2>
            <p class="mt-1 text-sm text-zinc-600">{g.description}</p>
            <p class="mt-3 text-xs font-semibold text-accent">{count(g.id)} stories</p>
          </a>
        ))
      }
    </div>

    {
      tags.length > 0 && (
        <section class="mt-12">
          <h2 class="mb-4 text-2xl font-bold">Popular tags</h2>
          <div class="flex flex-wrap gap-2">
            {tags.map((t) => (
              <a href={tagUrl(t)} data-slug={slugify(t)} class="rounded-full border border-zinc-300 px-3 py-1 text-sm hover:border-accent">
                #{t}
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
