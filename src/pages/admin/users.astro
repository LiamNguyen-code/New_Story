---
// Tài khoản: ai cũng đổi được mật khẩu của mình; admin thêm/xoá người, đặt lại mật khẩu, đổi quyền.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listUsers } from '../../lib/server/admin';

const me = Astro.locals.user!;
const users = me.role === 'admin' ? listUsers() : [];
const input =
  'mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-blue-100';
const card = 'space-y-4 rounded-xl border border-zinc-200 bg-white p-4 sm:p-5';
const primary = 'inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 disabled:opacity-50';
const small = 'rounded-md border border-zinc-300 bg-white px-2.5 py-1 text-xs font-medium text-zinc-700 hover:bg-zinc-50';
---

<AdminLayout title="Tài khoản">
  <div class="sticky top-14 z-30 -mx-4 mb-6 border-b border-zinc-200 bg-zinc-50/95 px-4 py-3 backdrop-blur">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="mr-auto text-xl font-bold text-slate-900 sm:text-2xl">Tài khoản</h1>
      <button type="button" data-logout class="inline-flex items-center rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50">
        Đăng xuất
      </button>
    </div>
  </div>

  <div class="grid gap-5 lg:grid-cols-[1fr_340px]">
    <div class="min-w-0 space-y-5">
      {
        me.role === 'admin' ? (
          <>
            <section class={card}>
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">Người quản trị ({users.length})</h2>
              <ul class="divide-y divide-zinc-100">
                {users.map((u) => (
                  <li class="flex flex-wrap items-center gap-x-3 gap-y-2 py-3" data-user={u.id} data-email={u.email}>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm font-semibold text-slate-900">
                        {u.name || u.email}
                        {u.id === me.id && <span class="ml-1 text-xs font-normal text-zinc-400">(bạn)</span>}
                      </p>
                      <p class="truncate text-xs text-zinc-500">{u.email}</p>
                    </div>
                    <select data-role class="rounded-md border border-zinc-300 bg-white px-2 py-1 text-xs" disabled={u.id === me.id}>
                      <option value="editor" selected={u.role === 'editor'}>Biên tập</option>
                      <option value="admin" selected={u.role === 'admin'}>Admin</option>
                    </select>
                    {u.id !== me.id && (
                      <>
                        <button type="button" data-reset class={small}>
                          Đặt lại mật khẩu
                        </button>
                        <button type="button" data-delete class={small + ' text-red-600 hover:bg-red-50'}>
                          Xoá
                        </button>
                      </>
                    )}
                  </li>
                ))}
              </ul>
              <p class="text-xs text-zinc-500">Biên tập: thêm/sửa/xoá truyện. Admin: thêm cả quản lý tài khoản.</p>
            </section>

            <form id="add-user" class={card}>
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">Thêm người</h2>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-medium">
                  Email *
                  <input name="email" type="email" required class={input} />
                </label>
                <label class="block text-sm font-medium">
                  Tên hiển thị
                  <input name="name" class={input} />
                </label>
                <label class="block text-sm font-medium">
                  Mật khẩu * <span class="font-normal text-zinc-400">(≥ 8 ký tự)</span>
                  <input name="password" type="text" required minlength="8" autocomplete="new-password" class={input + ' font-mono'} />
                </label>
                <label class="block text-sm font-medium">
                  Quyền
                  <select name="role" class={input}>
                    <option value="editor">Biên tập</option>
                    <option value="admin">Admin</option>
                  </select>
                </label>
              </div>
              <button class={primary}>Thêm người</button>
              <p class="text-xs text-zinc-500">Gửi email + mật khẩu cho người đó. Họ đăng nhập ở /admin/login/ và nên đổi mật khẩu ngay.</p>
            </form>
          </>
        ) : (
          <section class={card}>
            <p class="text-sm text-zinc-600">
              Bạn đang đăng nhập với quyền <strong>Biên tập</strong>. Chỉ admin mới quản lý được tài khoản của người khác.
            </p>
          </section>
        )
      }
    </div>

    <aside class="min-w-0">
      <form id="change-password" class={card}>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">Đổi mật khẩu của bạn</h2>
        <p class="text-xs text-zinc-500">{me.email}</p>
        <label class="block text-sm font-medium">
          Mật khẩu hiện tại
          <input name="current" type="password" required autocomplete="current-password" class={input} />
        </label>
        <label class="block text-sm font-medium">
          Mật khẩu mới <span class="font-normal text-zinc-400">(≥ 8 ký tự)</span>
          <input name="password" type="password" required minlength="8" autocomplete="new-password" class={input} />
        </label>
        <button class={primary + ' w-full'}>Đổi mật khẩu</button>
      </form>
    </aside>
  </div>
</AdminLayout>

<script>
  import { api, logout } from '../../lib/admin/content';
  import { toast } from '../../lib/admin/dom';

  const run = async (fn: () => Promise<unknown>, okMsg: string, reload = false) => {
    try {
      await fn();
      toast(okMsg);
      if (reload) setTimeout(() => location.reload(), 600);
      return true;
    } catch (e) {
      toast((e as Error).message, false);
      return false;
    }
  };
  const json = (method: string, body: unknown) => ({ method, body: JSON.stringify(body) });

  document.querySelector('[data-logout]')?.addEventListener('click', logout);

  document.getElementById('change-password')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const fd = new FormData(form);
    run(() => api('admin/password', json('POST', { current: fd.get('current'), password: fd.get('password') })), 'Đã đổi mật khẩu.').then((ok) => ok && form.reset());
  });

  document.getElementById('add-user')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(e.currentTarget as HTMLFormElement);
    run(() => api('admin/users', json('POST', Object.fromEntries(fd))), 'Đã thêm người.', true);
  });

  for (const li of document.querySelectorAll<HTMLElement>('[data-user]')) {
    const id = li.dataset.user;
    const email = li.dataset.email;
    li.querySelector<HTMLSelectElement>('[data-role]')?.addEventListener('change', (e) =>
      run(() => api(`admin/users/${id}`, json('PUT', { role: (e.target as HTMLSelectElement).value })), 'Đã đổi quyền.', true),
    );
    li.querySelector('[data-reset]')?.addEventListener('click', () => {
      const password = prompt(`Mật khẩu mới cho ${email} (≥ 8 ký tự):`);
      if (password) run(() => api(`admin/users/${id}`, json('PUT', { password })), 'Đã đặt lại mật khẩu. Người đó đã bị đăng xuất khỏi mọi thiết bị.');
    });
    li.querySelector('[data-delete]')?.addEventListener('click', () => {
      if (confirm(`Xoá tài khoản ${email}?`)) run(() => api(`admin/users/${id}`, { method: 'DELETE' }), 'Đã xoá tài khoản.', true);
    });
  }
</script>
