---
// Báo cáo lượt xem theo ngày / người phụ trách / truyện / từng trang. Chỉ admin xem được.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listUsers } from '../../lib/server/admin';
import { parseFilter, report, vnDay } from '../../lib/server/views';

const me = Astro.locals.user!;
// Báo cáo chỉ dành cho admin
if (me.role !== 'admin') return Astro.redirect('/admin/');
const isAdmin = true;
const filter = parseFilter(Astro.url.searchParams, me);
const { days, byOwner, byStory, byPage, total } = report(filter);
const users = isAdmin ? listUsers() : [];

const ownerLabel = (id: number, name?: string | null, email?: string | null) => (id === 0 ? 'Chưa gán' : name || email || `Tài khoản đã xoá (#${id})`);
const pct = (v: number) => (total.views ? ((v / total.views) * 100).toFixed(1) + '%' : '0%');
const fmt = (n: number) => n.toLocaleString('vi-VN');
const pageLabel = (ch: number) => (ch === 0 ? 'Trang giới thiệu' : `Chương ${ch}`);
const pageUrl = (slug: string, ch: number) => (ch === 0 ? `/story/${slug}/` : `/story/${slug}/chapter-${ch}/`);

// Nút chọn nhanh khoảng ngày
const shift = (day: string, n: number) => {
  const d = new Date(day + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
};
const today = vnDay();
const monthStart = today.slice(0, 8) + '01';
const prevMonthEnd = shift(monthStart, -1);
const presets = [
  { label: 'Hôm nay', from: today, to: today },
  { label: '7 ngày', from: shift(today, -6), to: today },
  { label: '30 ngày', from: shift(today, -29), to: today },
  { label: 'Tháng này', from: monthStart, to: today },
  { label: 'Tháng trước', from: prevMonthEnd.slice(0, 8) + '01', to: prevMonthEnd },
];
const qs = (p: Record<string, string | number | null>) =>
  '?' + new URLSearchParams(Object.entries(p).filter(([, v]) => v !== null && v !== '') as [string, string][]).toString();
const base = { from: filter.from, to: filter.to, owner: isAdmin ? filter.ownerId : null };

// ---- Biểu đồ cột lượt xem theo ngày (SVG, 1 chuỗi số liệu)
const W = 800;
const H = 220;
const pad = { top: 12, right: 8, bottom: 28, left: 44 };
const plotW = W - pad.left - pad.right;
const plotH = H - pad.top - pad.bottom;
const maxViews = Math.max(...days.map((d) => d.views), 0);
const niceMax = (() => {
  if (maxViews <= 4) return 4;
  const step = 10 ** Math.floor(Math.log10(maxViews / 4));
  const unit = [1, 2, 2.5, 5, 10].map((m) => m * step).find((u) => u * 4 >= maxViews)!;
  return unit * 4;
})();
const ticks = [0, 1, 2, 3, 4].map((i) => (niceMax / 4) * i);
const slot = plotW / Math.max(days.length, 1);
const barW = Math.max(2, Math.min(24, slot - 2));
const y = (v: number) => pad.top + plotH - (v / niceMax) * plotH;
const compact = (n: number) => (n >= 1000 ? `${+(n / 1000).toFixed(1)}K` : String(n));
const labelEvery = Math.ceil(days.length / 8);
const dm = (day: string) => `${day.slice(8, 10)}/${day.slice(5, 7)}`;
/** Cột bo góc 4px ở đầu, vuông ở chân */
const barPath = (x: number, top: number, w: number, bottom: number) => {
  const r = Math.min(4, w / 2, bottom - top);
  return `M${x},${bottom}V${top + r}Q${x},${top} ${x + r},${top}H${x + w - r}Q${x + w},${top} ${x + w},${top + r}V${bottom}Z`;
};

const card = 'rounded-xl border border-zinc-200 bg-white p-4 sm:p-5';
const th = 'px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500';
const thNum = th.replace('text-left', 'text-right');
const td = 'px-3 py-2 text-sm text-zinc-800';
const tdNum = td + ' text-right tabular-nums';
const input = 'mt-1 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-blue-100';
---

<AdminLayout title="Báo cáo lượt xem">
  <div class="sticky top-14 z-30 -mx-4 mb-6 border-b border-zinc-200 bg-zinc-50/95 px-4 py-3 backdrop-blur">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="mr-auto text-xl font-bold text-slate-900 sm:text-2xl">
        Báo cáo lượt xem
        {!isAdmin && <span class="ml-1 text-base font-normal text-zinc-400">(truyện của bạn)</span>}
      </h1>
      <a href={`/api/admin/reports/${qs(base)}`} class="inline-flex items-center rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50">
        ⬇ Tải CSV
      </a>
    </div>
  </div>

  <!-- Bộ lọc -->
  <form method="get" class={card + ' mb-5 flex flex-wrap items-end gap-3'}>
    <label class="text-sm font-medium">Từ ngày<br /><input type="date" name="from" value={filter.from} max={today} class={input} /></label>
    <label class="text-sm font-medium">Đến ngày<br /><input type="date" name="to" value={filter.to} max={today} class={input} /></label>
    {
      isAdmin && (
        <label class="text-sm font-medium">
          Người phụ trách
          <br />
          <select name="owner" class={input}>
            <option value="">Tất cả</option>
            {users.map((u) => (
              <option value={u.id} selected={u.id === filter.ownerId}>
                {u.name || u.email}
              </option>
            ))}
            <option value="0" selected={filter.ownerId === 0}>
              Chưa gán
            </option>
          </select>
        </label>
      )
    }
    <button class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">Xem</button>
    <div class="flex flex-wrap gap-1.5 sm:ml-auto">
      {
        presets.map((p) => (
          <a
            href={qs({ ...base, from: p.from, to: p.to })}
            class:list={[
              'rounded-full px-3 py-1.5 text-xs',
              p.from === filter.from && p.to === filter.to ? 'bg-slate-900 font-semibold text-white' : 'bg-white text-zinc-600 ring-1 ring-zinc-200 hover:bg-zinc-100',
            ]}
          >
            {p.label}
          </a>
        ))
      }
    </div>
  </form>

  <!-- Số tổng -->
  <div class="mb-5 grid gap-3 sm:grid-cols-4">
    <div class={card}>
      <p class="text-xs text-zinc-500">Lượt xem</p>
      <p class="mt-1 text-3xl font-semibold tabular-nums text-slate-900">{fmt(total.views)}</p>
    </div>
    <div class={card}>
      <p class="text-xs text-zinc-500">Người đọc (theo ngày)</p>
      <p class="mt-1 text-3xl font-semibold tabular-nums text-slate-900">{fmt(total.uniques)}</p>
    </div>
    <div class={card}>
      <p class="text-xs text-zinc-500">Truyện có lượt xem</p>
      <p class="mt-1 text-3xl font-semibold tabular-nums text-slate-900">{fmt(new Set(byStory.map((s) => s.storyId)).size)}</p>
    </div>
    <label class={card + ' block'}>
      <span class="text-xs text-zinc-500">Doanh thu AdSense kỳ này ($)</span>
      <input
        type="number"
        min="0"
        step="0.01"
        data-revenue
        data-total={total.views}
        placeholder="VD: 120"
        title="Nhập tổng doanh thu để chia theo tỷ lệ lượt xem"
        class="mt-1 w-full rounded-lg border border-zinc-300 px-2 py-1.5 text-lg tabular-nums focus:border-accent focus:outline-none"
      />
    </label>
  </div>

  <!-- Biểu đồ -->
  <section class={card + ' mb-5'}>
    <h2 class="text-sm font-semibold text-slate-900">Lượt xem theo ngày</h2>
    <p class="text-xs text-zinc-500">{dm(filter.from)}/{filter.from.slice(0, 4)} – {dm(filter.to)}/{filter.to.slice(0, 4)}</p>
    <div class="relative mt-3" data-chart>
      <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="Biểu đồ cột lượt xem theo ngày; số liệu chi tiết ở các bảng bên dưới">
        {
          ticks.map((t) => (
            <g>
              <line x1={pad.left} x2={W - pad.right} y1={y(t)} y2={y(t)} stroke="#e4e4e7" stroke-width="1" />
              <text x={pad.left - 8} y={y(t) + 4} text-anchor="end" font-size="11" fill="#71717a">
                {compact(t)}
              </text>
            </g>
          ))
        }
        {
          days.map((d, i) => {
            const x = pad.left + i * slot + (slot - barW) / 2;
            return (
              <g>
                {d.views > 0 && <path d={barPath(x, y(d.views), barW, y(0))} fill="#2563eb" />}
                {i % labelEvery === 0 && (
                  <text x={x + barW / 2} y={H - 8} text-anchor="middle" font-size="11" fill="#71717a">
                    {dm(d.day)}
                  </text>
                )}
                <rect
                  x={pad.left + i * slot}
                  y={pad.top}
                  width={slot}
                  height={plotH}
                  fill="transparent"
                  data-day={d.day}
                  data-views={d.views}
                  data-uniques={d.uniques}
                  tabindex="0"
                />
              </g>
            );
          })
        }
      </svg>
      <div data-tip class="pointer-events-none absolute z-10 hidden rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs shadow-lg"></div>
    </div>
  </section>

  {
    isAdmin && filter.ownerId === null && (
      <section class={card + ' mb-5 overflow-x-auto p-0 sm:p-0'}>
        <h2 class="px-4 pt-4 text-sm font-semibold text-slate-900 sm:px-5">Theo người phụ trách</h2>
        <table class="mt-2 w-full">
          <thead class="border-b border-zinc-100">
            <tr>
              <th class={th}>Người phụ trách</th>
              <th class={thNum}>Truyện</th>
              <th class={thNum}>Lượt xem</th>
              <th class={thNum}>Người đọc</th>
              <th class={thNum}>Tỷ lệ</th>
              <th class={thNum}>Ước tính $</th>
            </tr>
          </thead>
          <tbody>
            {byOwner.map((o) => (
              <tr class="border-b border-zinc-50 hover:bg-blue-50/40">
                <td class={td}>
                  <a href={qs({ ...base, owner: o.ownerId })} class="font-medium text-accent hover:underline">
                    {ownerLabel(o.ownerId, o.name, o.email)}
                  </a>
                </td>
                <td class={tdNum}>{o.stories}</td>
                <td class={tdNum}>{fmt(o.views)}</td>
                <td class={tdNum}>{fmt(o.uniques)}</td>
                <td class={tdNum}>{pct(o.views)}</td>
                <td class={tdNum} data-share={o.views}>
                  –
                </td>
              </tr>
            ))}
            {byOwner.length === 0 && (
              <tr>
                <td colspan="6" class="px-3 py-6 text-center text-sm text-zinc-500">
                  Chưa có lượt xem trong khoảng ngày này.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </section>
    )
  }

  <section class={card + ' mb-5 overflow-x-auto p-0 sm:p-0'}>
    <h2 class="px-4 pt-4 text-sm font-semibold text-slate-900 sm:px-5">Theo truyện</h2>
    <table class="mt-2 w-full">
      <thead class="border-b border-zinc-100">
        <tr>
          <th class={th}>Truyện</th>
          {isAdmin && <th class={th}>Phụ trách</th>}
          <th class={thNum}>Lượt xem</th>
          <th class={thNum}>Người đọc</th>
          <th class={thNum}>Tỷ lệ</th>
          <th class={thNum}>Ước tính $</th>
        </tr>
      </thead>
      <tbody>
        {
          byStory.map((s) => (
            <tr class="border-b border-zinc-50 hover:bg-blue-50/40">
              <td class={td}>
                <a href={`/admin/#/story/${encodeURIComponent(s.slug)}`} class="line-clamp-1 font-medium hover:text-accent">
                  {s.title}
                </a>
              </td>
              {isAdmin && <td class={td + ' whitespace-nowrap text-zinc-600'}>{ownerLabel(s.ownerId, s.ownerName, s.ownerEmail)}</td>}
              <td class={tdNum}>{fmt(s.views)}</td>
              <td class={tdNum}>{fmt(s.uniques)}</td>
              <td class={tdNum}>{pct(s.views)}</td>
              <td class={tdNum} data-share={s.views}>
                –
              </td>
            </tr>
          ))
        }
        {
          byStory.length === 0 && (
            <tr>
              <td colspan="6" class="px-3 py-6 text-center text-sm text-zinc-500">
                Chưa có lượt xem trong khoảng ngày này.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </section>

  <section class={card + ' overflow-x-auto p-0 sm:p-0'}>
    <h2 class="px-4 pt-4 text-sm font-semibold text-slate-900 sm:px-5">
      Chi tiết theo trang <span class="font-normal text-zinc-400">({byPage.length}{byPage.length > 300 && ', hiện 300 trang nhiều lượt xem nhất — tải CSV để xem đủ'})</span>
    </h2>
    <table class="mt-2 w-full">
      <thead class="border-b border-zinc-100">
        <tr>
          <th class={th}>Trang</th>
          <th class={th}>Truyện</th>
          {isAdmin && <th class={th}>Phụ trách</th>}
          <th class={thNum}>Lượt xem</th>
          <th class={thNum}>Người đọc</th>
          <th class={thNum}>Tỷ lệ</th>
        </tr>
      </thead>
      <tbody>
        {
          byPage.slice(0, 300).map((p) => (
            <tr class="border-b border-zinc-50 hover:bg-blue-50/40">
              <td class={td + ' whitespace-nowrap'}>
                <a href={pageUrl(p.slug, p.chapter)} target="_blank" class="hover:text-accent">
                  {pageLabel(p.chapter)} ↗
                </a>
              </td>
              <td class={td}>
                <span class="line-clamp-1 text-zinc-600">{p.title}</span>
              </td>
              {isAdmin && <td class={td + ' whitespace-nowrap text-zinc-600'}>{ownerLabel(p.ownerId, p.ownerName, p.ownerEmail)}</td>}
              <td class={tdNum}>{fmt(p.views)}</td>
              <td class={tdNum}>{fmt(p.uniques)}</td>
              <td class={tdNum}>{pct(p.views)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <p class="mt-4 text-xs text-zinc-500">
    Lượt xem được tính khi người đọc mở trang ≥ 3 giây; cùng 1 người xem lại trong 30 phút chỉ tính 1 lần; không tính bot và người đang đăng nhập admin. "Người đọc" = số trình
    duyệt khác nhau mỗi ngày. Ngày tính theo giờ Việt Nam. "Ước tính $" chia doanh thu bạn nhập theo tỷ lệ lượt xem.
  </p>
</AdminLayout>

<script>
  // Tooltip biểu đồ
  const chart = document.querySelector<HTMLElement>('[data-chart]');
  const tip = chart?.querySelector<HTMLElement>('[data-tip]');
  const showTip = (rect: SVGRectElement) => {
    if (!chart || !tip) return;
    const [y, m, d] = rect.dataset.day!.split('-');
    tip.replaceChildren();
    const value = document.createElement('div');
    value.className = 'text-sm font-semibold text-slate-900';
    value.textContent = `${Number(rect.dataset.views).toLocaleString('vi-VN')} lượt xem`;
    const sub = document.createElement('div');
    sub.className = 'text-zinc-500';
    sub.textContent = `${Number(rect.dataset.uniques).toLocaleString('vi-VN')} người đọc · ${d}/${m}/${y}`;
    tip.append(value, sub);
    tip.classList.remove('hidden');
    const box = chart.getBoundingClientRect();
    const r = rect.getBoundingClientRect();
    const left = Math.min(Math.max(r.left - box.left + r.width / 2 - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth);
    tip.style.left = `${left}px`;
    tip.style.top = '0px';
  };
  chart?.querySelectorAll<SVGRectElement>('rect[data-day]').forEach((rect) => {
    rect.addEventListener('pointerenter', () => showTip(rect));
    rect.addEventListener('focus', () => showTip(rect));
  });
  chart?.addEventListener('pointerleave', () => tip?.classList.add('hidden'));

  // Chia doanh thu theo tỷ lệ lượt xem (nhớ số đã nhập trên trình duyệt này)
  const revenue = document.querySelector<HTMLInputElement>('[data-revenue]');
  const totalViews = Number(revenue?.dataset.total ?? 0);
  const update = () => {
    const amount = Number(revenue?.value || 0);
    document.querySelectorAll<HTMLElement>('[data-share]').forEach((cell) => {
      cell.textContent = amount > 0 && totalViews > 0 ? '$' + ((Number(cell.dataset.share) / totalViews) * amount).toFixed(2) : '–';
    });
  };
  if (revenue) {
    const key = `revenue:${location.search}`;
    try {
      revenue.value = localStorage.getItem(key) ?? '';
    } catch {}
    revenue.addEventListener('input', () => {
      try {
        localStorage.setItem(key, revenue.value);
      } catch {}
      update();
    });
  }
  update();
</script>
