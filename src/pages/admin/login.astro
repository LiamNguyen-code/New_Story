---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Đã đăng nhập thì vào thẳng trang quản trị
const next = Astro.url.searchParams.get('next') ?? '';
const safeNext = next.startsWith('/admin/') ? next : '/admin/';
if (Astro.locals.user) return Astro.redirect(safeNext);
const input =
  'mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-blue-100';
---

<AdminLayout title="Đăng nhập" bare>
  <form id="login" data-next={safeNext} class="mx-auto mt-10 max-w-sm space-y-4 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-2xl font-bold">Đăng nhập</h1>
    <label class="block text-sm font-medium">
      Email
      <input name="email" type="email" required autocomplete="username" class={input} autofocus />
    </label>
    <label class="block text-sm font-medium">
      Mật khẩu
      <input name="password" type="password" required autocomplete="current-password" class={input} />
    </label>
    <p data-error role="alert" class="hidden text-sm font-medium text-red-600"></p>
    <button class="w-full rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 disabled:opacity-50">Đăng nhập</button>
    <p class="text-xs text-zinc-500">Quên mật khẩu? Nhờ quản trị viên đặt lại ở trang Tài khoản.</p>
  </form>
</AdminLayout>

<script>
  import { api } from '../../lib/admin/content';

  const form = document.getElementById('login') as HTMLFormElement;
  const error = form.querySelector<HTMLElement>('[data-error]')!;
  const button = form.querySelector('button')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.classList.add('hidden');
    button.disabled = true;
    try {
      const fd = new FormData(form);
      await api('auth/login', { method: 'POST', body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }) });
      location.href = form.dataset.next || '/admin/';
    } catch (err) {
      error.textContent = (err as Error).message;
      error.classList.remove('hidden');
      button.disabled = false;
    }
  });
</script>
