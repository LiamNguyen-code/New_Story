---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../site.config';
---

<PageLayout title={`Terms and Conditions | ${SITE.name}`} heading="Terms and Conditions" description={`Terms of use for ${SITE.name}.`}>
  <p><em>Last updated: November 19, 2026</em></p>
  <p>By accessing {SITE.name} you agree to these terms. If you do not agree, please do not use the site.</p>

  <h2>Content</h2>
  <p>
    All stories published on {SITE.name} are works of fiction. Any resemblance to real persons, living or dead, or actual events is
    purely coincidental.
  </p>

  <h2>Intellectual property</h2>
  <p>
    All stories, text, images and design on this site are owned by {SITE.name} or its licensors. You may share links to our pages, but you
    may not copy, republish or redistribute our content without written permission.
  </p>

  <h2>Third-party links and ads</h2>
  <p>Our site displays third-party advertisements and may link to external websites. We are not responsible for their content.</p>

  <h2>Disclaimer</h2>
  <p>The site is provided "as is" without warranties of any kind. We are not liable for any damages arising from its use.</p>

  <h2>Changes</h2>
  <p>We may revise these terms at any time. Continued use of the site means you accept the updated terms.</p>

  <h2>Contact</h2>
  <p>Questions about these terms? <a href="/contact/">Contact us</a>.</p>
</PageLayout>
