---
// /news/page/2/, /news/page/3/... (trang 1 là /news/)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import NewsList from '../../../components/NewsList.astro';
import { SITE } from '../../../site.config';
import { NEWS_PER_PAGE, getNews } from '../../../lib/content';
import { paginate } from '../../../lib/paginate';

const page = paginate(await getNews(), Astro.params.page, NEWS_PER_PAGE, (n) => (n === 1 ? '/news/' : `/news/page/${n}/`));
if (!page || page.currentPage === 1) return Astro.rewrite('/404/');
---

<BaseLayout title={`News – Page ${page.currentPage} | ${SITE.name}`} description={`Latest news from ${SITE.name}, page ${page.currentPage}.`} prev={page.prev} next={page.next}>
  <Breadcrumbs jsonOnly items={[{ name: 'News', href: '/news/' }, { name: `Page ${page.currentPage}` }]} />
  <div class="mx-auto max-w-[750px] px-4 py-6">
    <h1 class="sr-only">News – Page {page.currentPage}</h1>
    <NewsList items={page.data} next={page.next} />
  </div>
</BaseLayout>
