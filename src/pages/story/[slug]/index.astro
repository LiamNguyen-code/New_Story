---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Cover from '../../../components/Cover.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import AdSlot from '../../../components/AdSlot.astro';
import ChapterToc from '../../../components/ChapterToc.astro';
import RelatedChapters from '../../../components/RelatedChapters.astro';
import OtherPosts from '../../../components/OtherPosts.astro';
import ViewTracker from '../../../components/ViewTracker.astro';
import { SITE } from '../../../site.config';
import {
  chapterUrl,
  excerpt,
  formatDate,
  genreName,
  genreUrl,
  getAuthorName,
  getChapters,
  getStories,
  getStory,
  ogImageUrl,
  renderMarkdown,
  storyUrl,
  tagUrl,
} from '../../../lib/content';

const BOOK_ICON =
  'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25';

const story = await getStory(Astro.params.slug ?? '');
if (!story) return Astro.rewrite('/404/');

const { data } = story;
const [chapters, all] = await Promise.all([getChapters(story), getStories()]);
const author = getAuthorName(story.ownerId, data.author);
const otherPosts = all.filter((s) => s.id !== story.id).slice(0, 8);

const url = new URL(storyUrl(story.id), SITE.url).href;
const og = ogImageUrl(data.cover);
const title = data.seoTitle ?? (data.title.length + SITE.name.length + 3 <= 65 ? `${data.title} | ${SITE.name}` : data.title);
const description = data.seoDescription ?? data.description ?? excerpt(story.body ?? '');

const bookLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': url,
  name: data.title,
  url,
  description,
  image: new URL(og, SITE.url).href,
  genre: data.genres.map(genreName),
  keywords: data.tags.join(', '),
  inLanguage: SITE.lang,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  author: { '@type': 'Person', name: author ?? SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  numberOfPages: chapters.length,
  bookFormat: 'https://schema.org/EBook',
  isAccessibleForFree: true,
  hasPart: chapters.map((c) => ({
    '@type': 'Chapter',
    name: `Chapter ${c.data.number} - ${c.data.title}`,
    position: c.data.number,
    url: new URL(chapterUrl(story.id, c.data.number), SITE.url).href,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  image={og}
  imageAlt={data.coverAlt ?? data.title}
  type="book"
  publishedTime={data.publishDate}
  modifiedTime={data.updatedDate}
  next={chapters[0] && chapterUrl(story.id, chapters[0].data.number)}
  jsonLd={bookLd}
>
  <Breadcrumbs jsonOnly items={[{ name: genreName(data.genres[0]), href: genreUrl(data.genres[0]) }, { name: data.title }]} />

  <div class="reading-col px-4">
    <article data-pagefind-body>
      <header class="mb-10 mt-5 text-center">
        <div class="mb-3 text-[14px] font-bold uppercase tracking-wider text-blue-600">
          <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
          <span class="text-slate-400"> · {chapters.length} chapters</span>
          {author && <span class="text-slate-400"> · By {author}</span>}
        </div>
        <h1 class="mb-5 text-[32px] font-bold leading-[1.1] text-slate-900 sm:text-[44px] md:mb-6 md:text-[56px]">{data.title}</h1>
        {
          chapters.length > 0 && (
            <div class="flex flex-wrap items-center justify-center gap-3">
              <a
                href={chapterUrl(story.id, chapters[0].data.number)}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700"
              >
                <svg class="shrink-0" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={BOOK_ICON} />
                </svg>
                Read from start
              </a>
              <a
                href="#"
                data-resume
                data-slug={story.id}
                class="hidden items-center justify-center rounded-full border border-blue-600 bg-white px-6 py-3 text-sm font-bold text-blue-600 transition hover:bg-blue-50"
              >
                Continue
              </a>
            </div>
          )
        }
      </header>

      <Cover
        name={data.cover}
        alt={data.coverAlt ?? data.title}
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 760px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mx-auto block aspect-[1200/630] w-full rounded-lg object-cover"
      />

      <div class="reader mt-8" set:html={renderMarkdown(story.body)} />
    </article>

    <div class="mt-2 flex flex-wrap gap-2">
      {
        data.genres.map((g) => (
          <a href={genreUrl(g)} class="rounded-full bg-blue-50 px-3 py-1 text-sm font-medium text-blue-600 hover:bg-blue-100">
            {genreName(g)}
          </a>
        ))
      }
      {
        data.tags.map((t) => (
          <a href={tagUrl(t)} class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-600 hover:text-blue-600">
            #{t}
          </a>
        ))
      }
    </div>

    <AdSlot pos="top" />

    <div class="mt-8"><ShareButtons title={data.title} /></div>

    <RelatedChapters slug={story.id} cover={data.cover} chapters={chapters.slice(0, 6)} />
  </div>

  <ChapterToc slug={story.id} storyTitle={data.title} chapters={chapters} current={0} />

  <OtherPosts stories={otherPosts} />
  <ViewTracker slug={story.id} chapter={0} />
</BaseLayout>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-resume]');
  if (btn) {
    try {
      const history = JSON.parse(localStorage.getItem('reading-history') || '[]');
      const entry = history.find((h: { slug: string }) => h.slug === btn.dataset.slug);
      if (entry && entry.chapter > 1) {
        btn.href = entry.url;
        btn.textContent = `Continue · Chapter ${entry.chapter}`;
        btn.classList.replace('hidden', 'inline-flex');
      }
    } catch {}
  }
</script>
