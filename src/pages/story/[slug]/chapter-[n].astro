---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Cover from '../../../components/Cover.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import StoryCard from '../../../components/StoryCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import ChapterToc from '../../../components/ChapterToc.astro';
import RelatedChapters from '../../../components/RelatedChapters.astro';
import OtherPosts from '../../../components/OtherPosts.astro';
import ViewTracker from '../../../components/ViewTracker.astro';
import { SITE } from '../../../site.config';
import {
  chapterUrl,
  excerpt,
  genreName,
  genreUrl,
  getChapterBody,
  getChapters,
  getStories,
  getStory,
  ogImageUrl,
  renderMarkdown,
  storyUrl,
} from '../../../lib/content';

const story = await getStory(Astro.params.slug ?? '');
const chapters = story ? await getChapters(story) : [];
const index = chapters.findIndex((c) => String(c.data.number) === Astro.params.n);
if (!story || index < 0) return Astro.rewrite('/404/');

const chapter = chapters[index];
const [body, stories] = await Promise.all([getChapterBody(chapter), getStories()]);
const n = chapter.data.number;
const total = chapters.length;
const prev = chapters[index - 1];
const next = chapters[index + 1];
const prevUrl = prev && chapterUrl(story.id, prev.data.number);
const nextUrl = next && chapterUrl(story.id, next.data.number);

// Tách nội dung: [phần 1] Ad [phần 2] "May you like" [2 đoạn cuối]
const paras = renderMarkdown(body).split('</p>').filter((p) => p.trim());
const join = (list: string[]) => list.map((p) => p + '</p>').join('');
const adAt = SITE.inContentAdAfterParagraph;
const likeAt = Math.max(adAt + 3, paras.length - 2);
const hasAd = paras.length > adAt + 3;
const hasLike = paras.length > adAt + 5;
const part1 = hasAd ? join(paras.slice(0, adAt)) : join(paras);
const part2 = hasAd ? join(paras.slice(adAt, hasLike ? likeAt : undefined)) : '';
const part3 = hasLike ? join(paras.slice(likeAt)) : '';

const others = stories.filter((s) => s.id !== story.id);
const sameGenre = others.filter((s) => s.data.genres.some((g) => story.data.genres.includes(g)));
const mayLike = [...sameGenre, ...others.filter((s) => !sameGenre.includes(s))].slice(0, 3);
const otherPosts = others.slice(0, 8);
// "Related Stories" = 6 chương kế tiếp (vòng lại từ đầu nếu hết)
const related = [...chapters.slice(index + 1), ...chapters.slice(0, index)].slice(0, 6);

const heading = `Chapter ${n} - ${chapter.data.title}`;
const baseTitle = `${story.data.seoTitle ?? story.data.title} – Chapter ${n}`;
const seoTitle = baseTitle.length + SITE.name.length + 3 <= 65 ? `${baseTitle} | ${SITE.name}` : baseTitle;
const description = chapter.data.seoDescription ?? excerpt(body);
const url = new URL(chapterUrl(story.id, n), SITE.url).href;
const og = ogImageUrl(story.data.cover);

const chapterLd = {
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: heading,
  headline: `${story.data.title} – ${heading}`.slice(0, 110),
  url,
  position: n,
  description,
  image: new URL(og, SITE.url).href,
  inLanguage: SITE.lang,
  datePublished: story.data.publishDate.toISOString(),
  dateModified: (story.data.updatedDate ?? story.data.publishDate).toISOString(),
  wordCount: chapter.wordCount,
  isAccessibleForFree: true,
  isPartOf: {
    '@type': 'Book',
    '@id': new URL(storyUrl(story.id), SITE.url).href,
    name: story.data.title,
    url: new URL(storyUrl(story.id), SITE.url).href,
  },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<BaseLayout
  title={seoTitle}
  description={description}
  image={og}
  imageAlt={story.data.title}
  type="article"
  publishedTime={story.data.publishDate}
  modifiedTime={story.data.updatedDate}
  prev={prevUrl}
  next={nextUrl}
  jsonLd={chapterLd}
>
  <Breadcrumbs
    jsonOnly
    items={[
      { name: genreName(story.data.genres[0]), href: genreUrl(story.data.genres[0]) },
      { name: story.data.title, href: storyUrl(story.id) },
      { name: `Chapter ${n}` },
    ]}
  />

  <div class="reading-col px-4">
    <div class="min-w-0">
      <header class="mb-8 mt-5">
        <div class="mb-2 flex min-w-0 items-center gap-1.5 text-[13px] leading-snug">
          <a href={storyUrl(story.id)} class="min-w-0 truncate font-bold uppercase tracking-wider text-blue-600 hover:opacity-80">{story.data.title}</a>
          <span class="shrink-0 text-slate-300">/</span>
          <span class="shrink-0 whitespace-nowrap font-semibold tabular-nums text-slate-500">Chapter {n} / {total}</span>
        </div>
        <div class="mb-5 h-1 overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-label="Reading progress" aria-valuenow={index + 1} aria-valuemin="1" aria-valuemax={total}>
          <div class="h-full rounded-full bg-blue-600" style={`width: ${Math.round(((index + 1) / total) * 100)}%`}></div>
        </div>
        <h1 class="text-[32px] font-bold leading-[1.1] text-slate-900 sm:text-[44px] md:text-[56px]">{heading}</h1>
      </header>

      <Cover
        name={story.data.cover}
        alt={story.data.coverAlt ?? story.data.title}
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 760px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mx-auto block aspect-[1200/630] w-full rounded-lg object-cover"
      />

      <AdSlot pos="top" />

      <article class="reader mt-8" data-reader>
        <Fragment set:html={part1} />
        {hasAd && <AdSlot pos="inContent" />}
        {part2 && <Fragment set:html={part2} />}
        {
          hasLike && mayLike.length > 0 && (
            <aside class="my-10" aria-labelledby="maylike-heading">
              <h2 id="maylike-heading" class="mb-4 text-xl font-bold text-slate-900">
                May you like
              </h2>
              <div class="grid gap-4 sm:grid-cols-2">
                {mayLike.map((s) => (
                  <StoryCard story={s} variant="mini" />
                ))}
              </div>
            </aside>
          )
        }
        {part3 && <Fragment set:html={part3} />}
      </article>
      <div data-chapter-end aria-hidden="true"></div>

      <div class="mt-8"><ShareButtons title={`${story.data.title} – ${heading}`} /></div>

      <nav aria-label="Chapter navigation" class="mt-8 grid gap-3 border-t border-slate-200 pt-6 sm:grid-cols-2">
        <a
          href={prevUrl ?? storyUrl(story.id)}
          rel={prevUrl ? 'prev' : undefined}
          class="flex min-h-[88px] items-center gap-3 rounded-2xl border border-slate-200 bg-white px-5 py-4 transition hover:border-slate-300 hover:shadow-sm"
        >
          <span class="text-xl text-slate-400" aria-hidden="true">‹</span>
          <span class="min-w-0">
            <span class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400">{prevUrl ? 'Previous' : 'View intro'}</span>
            <span class="mt-1 line-clamp-2 text-[15px] font-medium leading-snug text-slate-900">
              {prev ? `Chapter ${prev.data.number} - ${prev.data.title}` : story.data.title}
            </span>
          </span>
        </a>
        {
          nextUrl ? (
            <a
              href={nextUrl}
              rel="next"
              data-next
              class="flex min-h-[88px] items-center justify-end gap-3 rounded-2xl border border-blue-600 bg-blue-600 px-5 py-4 text-right text-white transition hover:bg-blue-700"
            >
              <span class="min-w-0">
                <span class="block text-[11px] font-semibold uppercase tracking-wider text-blue-100">Next chapter</span>
                <span class="mt-1 line-clamp-2 text-[15px] font-medium leading-snug">
                  Chapter {next!.data.number} - {next!.data.title}
                </span>
              </span>
              <span class="text-xl text-blue-100" aria-hidden="true">›</span>
            </a>
          ) : (
            <a
              href={storyUrl(story.id)}
              class="flex min-h-[88px] flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-4 text-center transition hover:border-slate-300 hover:shadow-sm"
            >
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400">The end · View intro</span>
              <span class="mt-1 line-clamp-2 text-[15px] font-medium leading-snug text-slate-900">{story.data.title}</span>
            </a>
          )
        }
      </nav>

      <AdSlot pos="bottom" />

      <RelatedChapters slug={story.id} cover={story.data.cover} chapters={related} />
    </div>
  </div>

  <ChapterToc slug={story.id} storyTitle={story.data.title} chapters={chapters} current={n} />

  <OtherPosts stories={otherPosts} />
  <ViewTracker slug={story.id} chapter={n} />
</BaseLayout>

<script
  is:inline
  define:vars={{
    entry: { slug: story.id, title: story.data.title, chapter: n, total, url: chapterUrl(story.id, n) },
    nextUrl: nextUrl ?? null,
    prevUrl: prevUrl ?? null,
  }}
>
  // Lưu lịch sử đọc (tối đa 10 truyện) cho mục "Continue reading"
  try {
    const key = 'reading-history';
    const list = JSON.parse(localStorage.getItem(key) || '[]').filter((h) => h.slug !== entry.slug);
    list.unshift({ ...entry, at: Date.now() });
    localStorage.setItem(key, JSON.stringify(list.slice(0, 10)));
  } catch (e) {}

  // Phím ← → để chuyển chương
  document.addEventListener('keydown', (e) => {
    if (e.target.closest && e.target.closest('input,select,textarea')) return;
    if (e.key === 'ArrowRight' && nextUrl) location.href = nextUrl;
    if (e.key === 'ArrowLeft' && prevUrl) location.href = prevUrl;
  });

  // Sự kiện GA: đọc hết chương / bấm chương sau
  const io = new IntersectionObserver((es) => {
    if (es[0].isIntersecting) {
      window.gtag?.('event', 'chapter_complete', { story: entry.slug, chapter: entry.chapter });
      io.disconnect();
    }
  });
  io.observe(document.querySelector('[data-chapter-end]'));
  document.querySelector('[data-next]')?.addEventListener('click', () =>
    window.gtag?.('event', 'next_chapter', { story: entry.slug, chapter: entry.chapter }),
  );
</script>
