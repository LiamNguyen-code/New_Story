---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StoryCard from '../components/StoryCard.astro';
import { SITE } from '../site.config';
import { searchStories } from '../lib/content';

const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100);
const results = q.trim() ? await searchStories(q) : [];
---

<BaseLayout title={`Search | ${SITE.name}`} description={`Search stories on ${SITE.name}.`} noindex>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <Breadcrumbs items={[{ name: 'Search' }]} />
    <h1 class="mb-6 mt-4 text-3xl font-bold">Search stories</h1>
    <form method="get" action="/search/" role="search" class="flex gap-2">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Title, tag, character…"
        aria-label="Search stories"
        class="min-w-0 flex-1 rounded-xl border border-zinc-300 bg-white px-4 py-3 focus:border-accent focus:outline-none focus:ring-2 focus:ring-blue-100"
        autofocus
      />
      <button class="rounded-xl bg-accent px-5 py-3 font-semibold text-white hover:opacity-90">Search</button>
    </form>

    {
      q.trim() && (
        <p class="mt-6 text-sm text-zinc-500">
          {results.length} {results.length === 1 ? 'result' : 'results'} for “{q}”
        </p>
      )
    }
    <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4">
      {results.map((s) => <StoryCard story={s} variant="small" />)}
    </div>
  </div>
</BaseLayout>
