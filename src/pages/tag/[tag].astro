---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import { SITE } from '../../site.config';
import { getStories, slugify } from '../../lib/content';

const key = Astro.params.tag ?? '';
const stories = (await getStories()).filter((s) => s.data.tags.some((t) => slugify(t) === key));
if (!stories.length) return Astro.rewrite('/404/');
const name = stories[0].data.tags.find((t) => slugify(t) === key)!;
---

<BaseLayout
  title={`#${name} Stories | ${SITE.name}`}
  description={`Read ${stories.length} free serial ${stories.length === 1 ? 'story' : 'stories'} tagged "${name}" on ${SITE.name}.`}
  noindex={stories.length < 2}
>
  <StoryGrid heading={`#${name}`} subheading={`Stories tagged “${name}”`} stories={stories} />
</BaseLayout>
