---
// Trang danh sách /page/2/, /page/3/... (trang 1 chính là trang chủ)
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import { SITE } from '../../site.config';
import { getStories, sortFeatured } from '../../lib/content';
import { paginate } from '../../lib/paginate';

const page = paginate(sortFeatured(await getStories()), Astro.params.page, SITE.storiesPerPage, (n) => (n === 1 ? '/' : `/page/${n}/`));
if (!page || page.currentPage === 1) return Astro.rewrite('/404/');
---

<BaseLayout
  title={`Recent Stories – Page ${page.currentPage} | ${SITE.name}`}
  description={`Browse stories on ${SITE.name}, page ${page.currentPage}.`}
  prev={page.prev}
  next={page.next}
>
  <StoryGrid heading="Recent Stories" subheading={`Page ${page.currentPage} of ${page.lastPage}`} stories={page.data} prev={page.prev} next={page.next} />
</BaseLayout>
