---
// Trang danh sách /page/2/, /page/3/... (trang 1 chính là trang chủ)
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import { SITE } from '../../site.config';
import { getStories } from '../../lib/content';

export const getStaticPaths = (async ({ paginate }) => {
  const stories = await getStories();
  const sorted = [...stories.filter((s) => s.data.featured), ...stories.filter((s) => !s.data.featured)];
  return paginate(sorted, { pageSize: SITE.storiesPerPage }).filter((p) => p.params.page !== undefined);
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const prev = page.currentPage === 2 ? '/' : page.url.prev;
---

<BaseLayout
  title={`Recent Stories – Page ${page.currentPage} | ${SITE.name}`}
  description={`Browse stories on ${SITE.name}, page ${page.currentPage}.`}
  prev={prev}
  next={page.url.next}
>
  <StoryGrid heading="Recent Stories" subheading={`Page ${page.currentPage} of ${page.lastPage}`} stories={page.data} prev={prev} next={page.url.next} />
</BaseLayout>
