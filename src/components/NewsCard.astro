---
// Thẻ tin ngang: ảnh trái, tiêu đề + ngày đăng + đoạn trích bên phải.
import Cover from './Cover.astro';
import { excerpt, formatLongDate, newsUrl, type News } from '../lib/content';

interface Props {
  item: News;
  eager?: boolean;
}
const { item, eager = false } = Astro.props;
const { data } = item;
const href = newsUrl(item.id);
const summary = data.description ?? excerpt(item.body ?? '', 160);
---

<article class="news-card group relative flex overflow-hidden border border-zinc-200 bg-white transition hover:shadow-md">
  <a href={href} class="block w-[38%] max-w-[220px] shrink-0 overflow-hidden bg-zinc-100 sm:w-[220px]" tabindex="-1" aria-hidden="true">
    <Cover
      name={data.cover}
      alt=""
      widths={[240, 480]}
      sizes="220px"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="aspect-square h-full w-full object-cover"
    />
  </a>
  <div class="min-w-0 flex-1 px-3 py-3 sm:px-4 sm:py-4">
    <h2 class="line-clamp-2 text-[15px] font-bold leading-snug text-zinc-900 sm:text-[20px] sm:leading-[1.3]">
      <a href={href} class="after:absolute after:inset-0 group-hover:text-accent">{data.title}</a>
    </h2>
    <p class="mt-1.5 flex items-center gap-1 text-[12px] font-semibold text-zinc-800 sm:text-[14px]">
      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0" fill="currentColor" aria-hidden="true"
        ><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .25.43l3.5 2a.5.5 0 0 0 .5-.86L8 8.71V3.5z"></path><path
          d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"></path></svg
      >
      <time datetime={data.publishDate.toISOString()}>Posted {formatLongDate(data.publishDate)}</time>
    </p>
    <p class="mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-zinc-600 sm:text-[16px]">{summary}</p>
  </div>
</article>
