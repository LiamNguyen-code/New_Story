---
import StoryCard from './StoryCard.astro';
import Pagination from './Pagination.astro';
import type { Story } from '../lib/content';

interface Props {
  heading: string;
  subheading?: string;
  stories: Story[];
  prev?: string;
  next?: string;
}
const { heading, subheading, stories, prev, next } = Astro.props;
---

<div class="container mx-auto px-4 py-12 md:py-14">
  <header class="mx-auto mb-14 max-w-[718px] text-center">
    <h1 class="mb-4 text-4xl font-bold leading-tight text-slate-900 md:text-[40px]">{heading}</h1>
    {subheading && <p class="text-lg leading-relaxed text-slate-600 md:text-xl">{subheading}</p>}
  </header>
  <slot />
  {stories.length === 0 && <p class="text-center text-zinc-500">No stories yet. Check back soon!</p>}
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
    {stories.map((s, i) => <StoryCard story={s} eager={i < 3} />)}
  </div>
  <Pagination prev={prev} next={next} />
</div>
