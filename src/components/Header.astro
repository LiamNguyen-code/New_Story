---
import { NAV, SITE } from '../site.config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' || path.startsWith('/page/') || path.startsWith('/story/') : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-zinc-200 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4">
    <a href="/" class="font-logo text-2xl font-semibold tracking-tight text-zinc-950 transition-opacity hover:opacity-80">{SITE.name.toLowerCase()}</a>

    <nav aria-label="Main" class="hidden items-center gap-6 text-sm font-medium md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'border-b-2 pb-1 transition-colors',
              isActive(item.href) ? 'border-zinc-900 text-zinc-900' : 'border-transparent text-zinc-600 hover:text-zinc-900',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="md:hidden">
      <summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold hover:bg-zinc-100">Menu</summary>
      <nav aria-label="Mobile" class="absolute inset-x-0 top-16 z-40 flex flex-col gap-4 border-b border-zinc-200 bg-white p-4 shadow-lg">
        {
          NAV.map((item) => (
            <a href={item.href} class:list={['transition-colors', isActive(item.href) ? 'font-medium text-accent' : 'text-zinc-600 hover:text-zinc-900']}>
              {item.label}
            </a>
          ))
        }
        <a href="/privacy/" class="text-zinc-600 hover:text-zinc-900">Privacy Policy</a>
      </nav>
    </details>
  </div>
</header>
