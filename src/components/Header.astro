---
import { NAV, SITE } from '../site.config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' || path.startsWith('/page/') : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-zinc-200 bg-white">
  <div class="mx-auto flex h-16 max-w-[1120px] items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-logo text-2xl font-bold tracking-tight text-zinc-900">{SITE.name.toLowerCase()}</a>

    <nav aria-label="Main" class="hidden items-center gap-6 text-[13px] text-zinc-600 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative py-1 hover:text-zinc-900',
              isActive(item.href) && 'font-medium text-zinc-900 after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:bg-zinc-900',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none text-sm font-medium text-zinc-900">Menu</summary>
      <nav aria-label="Mobile" class="absolute right-0 mt-3 w-52 rounded-xl border border-zinc-200 bg-white p-2 shadow-lg">
        {
          NAV.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-zinc-700 hover:bg-zinc-100">
              {item.label}
            </a>
          ))
        }
        <a href="/privacy/" class="block rounded-lg px-3 py-2 text-sm text-zinc-700 hover:bg-zinc-100">Privacy Policy</a>
      </nav>
    </details>
  </div>
</header>
