---
import { SITE } from '../site.config';

interface Props {
  title: string;
}
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).href;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

// Icon SVG 24x24 (path d)
const links = [
  { name: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`, color: 'text-zinc-900', d: 'M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z' },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, color: 'text-[#1877f2]', d: 'M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H7v4h2v9h4v-9h3l1-4h-4V9c0-.6.4-1 1-1z' },
  { name: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${t}`, color: 'text-[#ff4500]', d: 'M22 12.1a2.2 2.2 0 0 0-3.7-1.6 10.8 10.8 0 0 0-5.8-1.8l1-4.6 3.2.7a1.6 1.6 0 1 0 .2-.9l-3.6-.8a.5.5 0 0 0-.5.4l-1.1 5.2c-2.2 0-4.2.7-5.8 1.8a2.2 2.2 0 1 0-2.4 3.6v.6c0 3.3 3.8 6 8.5 6s8.5-2.7 8.5-6v-.6c.8-.4 1.5-1.1 1.5-2zM7.5 13.6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zm8.4 4c-1 1-2.4 1.4-3.9 1.4s-2.9-.5-3.9-1.4a.4.4 0 0 1 .6-.6c.8.8 2 1.1 3.3 1.1s2.5-.4 3.3-1.1a.4.4 0 0 1 .6.6zm-.4-2.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z' },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, color: 'text-[#0a66c2]', d: 'M6.5 8.5h-3V21h3V8.5zM5 3a1.8 1.8 0 1 0 0 3.6A1.8 1.8 0 0 0 5 3zm15.5 10.6c0-3-1.6-5.3-4.6-5.3-1.5 0-2.6.8-3 1.6V8.5H10V21h3v-6.5c0-1.7.6-3 2.2-3s2.3 1.4 2.3 3V21h3v-7.4z' },
  { name: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`, color: 'text-[#25d366]', d: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1a17 17 0 0 1-1.7-.7c-3-1.3-5-4.3-5.1-4.5-.2-.2-1.2-1.6-1.2-3s.8-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.2c.1.2.1.4 0 .6l-.3.5-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2.1 1c.3.1.5.2.5.3.1.2.1.8-.1 1.5z' },
  { name: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}`, color: 'text-[#229ed9]', d: 'M21.5 4.3 2.9 11.5c-1.3.5-1.3 1.2-.2 1.6l4.8 1.5 1.8 5.6c.2.6.4.8.8.8.4 0 .6-.2.9-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.8c.3-1.3-.5-1.9-1.4-1.5zM8.7 14.3l9.4-5.9c.4-.3.8-.1.5.2l-7.6 6.9-.3 3.2-2-4.4z' },
  { name: 'Email', href: `mailto:?subject=${t}&body=${u}`, color: 'text-[#9333ea]', d: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.4 7l6.6 4.4L18.6 7H5.4z' },
];
---

<div class="flex items-center justify-between gap-3 rounded-xl border border-zinc-200 bg-white px-4 py-3.5">
  <span class="text-[10px] font-medium uppercase tracking-[0.15em] text-zinc-500">Share</span>
  <div class="flex flex-wrap justify-end gap-2">
    {
      links.map((l) => (
        <a
          href={l.href}
          target={l.name === 'Email' ? undefined : '_blank'}
          rel="noopener nofollow"
          aria-label={`Share on ${l.name}`}
          data-share={l.name}
          class={`flex h-8 w-8 items-center justify-center rounded-full border border-zinc-200 bg-white hover:bg-zinc-50 ${l.color}`}
        >
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
            <path d={l.d} />
          </svg>
        </a>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-share]').forEach((a) =>
    a.addEventListener('click', () => (window as any).gtag?.('event', 'share', { method: a.dataset.share })),
  );
</script>
