---
import Cover from './Cover.astro';
import { chapterUrl, type Chapter } from '../lib/content';

interface Props {
  slug: string;
  cover: string;
  chapters: Chapter[];
}
const { slug, cover, chapters } = Astro.props;
---

{
  chapters.length > 0 && (
    <section class="mt-10" aria-labelledby="related-heading">
      <h2 id="related-heading" class="mb-4 text-xl font-bold text-slate-900">
        Related Stories
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {chapters.map((c) => (
          <a
            href={chapterUrl(slug, c.data.number)}
            class="group flex min-h-[112px] overflow-hidden rounded-xl border border-slate-200 bg-white transition hover:border-slate-300 hover:shadow-sm"
          >
            <div class="w-28 shrink-0 overflow-hidden bg-slate-100 sm:w-32">
              <Cover name={cover} alt="" widths={[240]} sizes="128px" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
            </div>
            <span class="flex min-w-0 flex-1 items-center px-4 py-3">
              <span class="line-clamp-3 text-base font-semibold leading-snug text-slate-900 group-hover:text-blue-600 sm:text-lg">
                Chapter {c.data.number} - {c.data.title}
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}
