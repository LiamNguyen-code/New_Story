---
import Cover from './Cover.astro';
import { formatDate, storyUrl, type Story } from '../lib/content';

interface Props {
  story: Story;
  /** grid: thẻ lớn trang chủ · small: "Other posts" 4 cột · mini: "May you like" */
  variant?: 'grid' | 'small' | 'mini';
  eager?: boolean;
}
const { story, variant = 'grid', eager = false } = Astro.props;
const { data } = story;
const href = storyUrl(story.id);
const date = formatDate(data.publishDate);
---

{
  variant === 'grid' && (
    <article class="flex flex-col overflow-hidden rounded-xl border border-zinc-200 bg-white">
      <a href={href} class="block h-[190px] overflow-hidden bg-zinc-100" tabindex="-1" aria-hidden="true">
        <Cover
          name={data.cover}
          alt=""
          widths={[480, 800]}
          sizes="(min-width: 1024px) 390px, (min-width: 640px) 50vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          class="h-full w-full object-cover"
        />
      </a>
      <div class="flex flex-1 flex-col px-6 pb-6 pt-5">
        <time class="text-[11px] text-zinc-500" datetime={data.publishDate.toISOString()}>
          {date}
          {data.draft && <span class="ml-1 rounded bg-yellow-200 px-1 text-yellow-900">DRAFT</span>}
        </time>
        <h3 class="mt-4 text-[22px] font-bold leading-[1.3] text-slate-900">
          <a href={href} class="hover:text-accent">{data.title}</a>
        </h3>
        <a href={href} class="mt-auto pt-8 text-xs font-semibold text-accent hover:underline">Read Article →</a>
      </div>
    </article>
  )
}

{
  variant === 'small' && (
    <article class="overflow-hidden rounded-xl border border-zinc-200 bg-white">
      <a href={href} class="block h-[88px] overflow-hidden bg-zinc-100 sm:h-[100px]" tabindex="-1" aria-hidden="true">
        <Cover name={data.cover} alt="" widths={[240, 480]} sizes="(min-width: 768px) 230px, 50vw" class="h-full w-full object-cover" />
      </a>
      <div class="p-2.5 pb-4">
        <time class="text-[9px] uppercase tracking-wide text-zinc-500" datetime={data.publishDate.toISOString()}>{date}</time>
        <h3 class="mt-1.5 line-clamp-5 text-[15px] font-medium leading-snug text-slate-900">
          <a href={href} class="hover:text-accent">{data.title}</a>
        </h3>
      </div>
    </article>
  )
}

{
  variant === 'mini' && (
    <a href={href} class="block overflow-hidden rounded-xl border border-zinc-200 bg-white hover:shadow-sm">
      <div class="flex h-[140px] items-center justify-center bg-slate-50">
        <Cover name={data.cover} alt="" widths={[240, 480]} sizes="250px" class="h-full w-full object-cover" />
      </div>
      <p class="line-clamp-2 px-2.5 py-2.5 text-[12px] font-medium leading-snug text-slate-900">{data.title}</p>
    </a>
  )
}
