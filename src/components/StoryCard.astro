---
import Cover from './Cover.astro';
import { formatDate, storyUrl, type Story } from '../lib/content';

interface Props {
  story: Story;
  /** grid: thẻ lớn trang chủ · small: "Other posts" 4 cột · mini: "May you like" */
  variant?: 'grid' | 'small' | 'mini';
  eager?: boolean;
}
const { story, variant = 'grid', eager = false } = Astro.props;
const { data } = story;
const href = storyUrl(story.id);
const date = formatDate(data.publishDate);
---

{
  variant === 'grid' && (
    <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-300 hover:shadow-lg hover:shadow-slate-200/50">
      <a href={href} class="relative block h-48 overflow-hidden bg-slate-100" tabindex="-1" aria-hidden="true">
        <Cover
          name={data.cover}
          alt=""
          widths={[480, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </a>
      <div class="flex flex-1 flex-col p-6">
        <time class="mb-3 text-sm font-medium text-slate-500" datetime={data.publishDate.toISOString()}>
          {date}
          {data.draft && <span class="ml-1 rounded bg-yellow-200 px-1 text-yellow-900">DRAFT</span>}
        </time>
        <h2 class="mb-3 text-2xl font-bold leading-tight text-slate-900 transition-colors group-hover:text-blue-600 md:text-[32px]">
          <a href={href}>{data.title}</a>
        </h2>
        <div class="mb-4 flex-1"></div>
        <a href={href} class="inline-flex items-center gap-1 text-base font-bold text-blue-600 transition-all hover:text-blue-700 group-hover:gap-2">
          Read Article <span aria-hidden="true" class="text-base leading-none">→</span>
        </a>
      </div>
    </article>
  )
}

{
  variant === 'small' && (
    <article class="overflow-hidden rounded-xl border border-zinc-200 bg-white">
      <a href={href} class="block h-[88px] overflow-hidden bg-zinc-100 sm:h-[100px]" tabindex="-1" aria-hidden="true">
        <Cover name={data.cover} alt="" widths={[240, 480]} sizes="(min-width: 768px) 230px, 50vw" class="h-full w-full object-cover" />
      </a>
      <div class="p-2.5 pb-4">
        <time class="text-[9px] uppercase tracking-wide text-zinc-500" datetime={data.publishDate.toISOString()}>{date}</time>
        <h3 class="mt-1.5 line-clamp-5 text-[15px] font-medium leading-snug text-slate-900">
          <a href={href} class="hover:text-accent">{data.title}</a>
        </h3>
      </div>
    </article>
  )
}

{
  variant === 'mini' && (
    <a href={href} class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:border-slate-300 hover:shadow-sm">
      <div class="h-48 overflow-hidden bg-slate-50">
        <Cover name={data.cover} alt="" widths={[480, 800]} sizes="(min-width: 640px) 370px, 100vw" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
      </div>
      <p class="px-3 py-3 text-lg font-semibold leading-snug text-slate-900 group-hover:text-blue-600"><span class="line-clamp-2">{data.title}</span></p>
    </a>
  )
}
