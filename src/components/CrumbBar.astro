---
// Thanh breadcrumb kiểu: "TÊN TRUYỆN (xanh, in hoa) / Chapter 1 / 20" + vạch xanh ngắn bên dưới
interface Props {
  title: string;
  href: string;
  label: string;
}
const { title, href, label } = Astro.props;
---

<div class="relative flex min-w-0 items-center gap-2 border-b border-zinc-100 pb-2.5 pt-6 text-[12px] sm:text-[13px]">
  <a href={href} class="truncate font-bold uppercase tracking-[0.04em] text-accent hover:underline">{title}</a>
  <span class="shrink-0 text-zinc-300">/</span>
  <span class="shrink-0 text-zinc-500">{label}</span>
  <span class="absolute -bottom-px left-0 h-[3px] w-10 rounded-full bg-accent" aria-hidden="true"></span>
</div>
