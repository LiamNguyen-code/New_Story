---
import { FOOTER_NAV, SITE } from '../site.config';
---

<footer class="mt-20 border-t border-zinc-200 bg-white">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row">
    <a href="/" class="font-logo text-xl font-semibold text-zinc-950">{SITE.name.toLowerCase()}</a>
    <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-[13px] text-zinc-500">
      {FOOTER_NAV.map((l) => <a class="hover:text-zinc-900" href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <p class="pb-6 text-center text-xs text-zinc-400">© {new Date().getFullYear()} {SITE.name}. All stories are works of fiction.</p>
  <a href="#" aria-label="Back to top" class="fixed bottom-5 left-5 z-30 hidden h-10 w-10 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-600 shadow-sm hover:text-zinc-900 md:flex">↑</a>
</footer>
