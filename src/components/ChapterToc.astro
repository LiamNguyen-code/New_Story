---
// Mục lục chương: thẻ cố định bên phải (desktop) + nút nổi "≡ 1/20" mở bảng (mobile).
import { chapterUrl, type Chapter } from '../lib/content';

interface Props {
  slug: string;
  storyTitle: string;
  chapters: Chapter[];
  /** Số chương đang đọc (0 = trang giới thiệu) */
  current: number;
}
const { slug, storyTitle, chapters, current } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<aside
  id="chapter-toc"
  class="fixed inset-x-0 bottom-0 z-50 hidden max-h-[75vh] flex-col overflow-hidden rounded-t-2xl border border-zinc-200 bg-white shadow-2xl data-[open]:flex xl:sticky xl:top-[80px] xl:z-auto xl:flex xl:max-h-[calc(100vh-100px)] xl:rounded-2xl xl:shadow-[0_10px_30px_-12px_rgba(15,23,42,0.18)]"
  aria-label="Table of contents"
>
  <div class="flex items-center gap-2.5 border-b border-zinc-100 px-4 py-3.5">
    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
      ><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg
    >
    <span class="line-clamp-1 flex-1 text-[13px] font-semibold text-slate-900">{storyTitle}</span>
    <button type="button" data-toc-close class="text-xl leading-none text-zinc-400 xl:hidden" aria-label="Close">×</button>
  </div>
  <div class="flex items-center justify-between px-4 pb-1 pt-3 text-[10px] uppercase tracking-[0.1em] text-zinc-400">
    <span>Table of contents</span>
    <span>{chapters.length}</span>
  </div>
  <ol class="overflow-y-auto overscroll-contain">
    {
      chapters.map((c) => {
        const active = c.data.number === current;
        return (
          <li class="border-b border-zinc-100 last:border-0">
            <a
              href={chapterUrl(slug, c.data.number)}
              aria-current={active ? 'page' : undefined}
              data-active={active || undefined}
              class:list={['flex items-center gap-3 px-4 py-2.5 text-[12.5px] hover:bg-blue-50', active ? 'bg-blue-50 font-medium text-accent' : 'text-slate-700']}
            >
              <span
                class:list={[
                  'flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[11px] font-semibold',
                  active ? 'bg-accent text-white' : 'bg-blue-50 text-accent',
                ]}
              >
                {pad(c.data.number)}
              </span>
              <span class="line-clamp-1">
                Chapter {c.data.number} - {c.data.title}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</aside>

<button
  type="button"
  data-toc-open
  class="fixed bottom-24 right-4 z-40 flex items-center gap-1.5 rounded-full bg-accent px-3.5 py-2 text-xs font-semibold text-white shadow-lg xl:hidden"
  aria-controls="chapter-toc"
>
  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
    ><path d="M4 6h16M4 12h12M4 18h8"></path></svg
  >
  {current || 0}/{chapters.length}
</button>
<div data-toc-backdrop class="fixed inset-0 z-40 hidden bg-black/30 xl:!hidden"></div>

<script>
  const toc = document.getElementById('chapter-toc')!;
  const backdrop = document.querySelector<HTMLElement>('[data-toc-backdrop]')!;
  const setOpen = (open: boolean) => {
    toc.toggleAttribute('data-open', open);
    backdrop.classList.toggle('hidden', !open);
    if (open) toc.querySelector('[data-active]')?.scrollIntoView({ block: 'center' });
  };
  document.querySelector('[data-toc-open]')?.addEventListener('click', () => setOpen(true));
  document.querySelector('[data-toc-close]')?.addEventListener('click', () => setOpen(false));
  backdrop.addEventListener('click', () => setOpen(false));
  // Desktop: cuộn mục lục tới chương hiện tại
  const active = toc.querySelector<HTMLElement>('[data-active]');
  const list = toc.querySelector('ol')!;
  if (active && matchMedia('(min-width: 1280px)').matches) list.scrollTop = active.offsetTop - list.clientHeight / 2;
</script>
