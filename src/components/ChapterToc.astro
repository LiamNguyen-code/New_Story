---
// Mục lục chương: thẻ nổi cố định bên phải (màn hình ≥ 1280px) + nút nổi "Chapters" mở bảng (điện thoại / màn nhỏ).
import { chapterUrl, type Chapter } from '../lib/content';

interface Props {
  slug: string;
  storyTitle: string;
  chapters: Chapter[];
  /** Số chương đang đọc (0 = trang giới thiệu) */
  current: number;
}
const { slug, storyTitle, chapters, current } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<aside
  id="chapter-toc"
  class="fixed inset-x-0 bottom-0 z-50 hidden max-h-[75vh] flex-col overflow-hidden rounded-t-2xl border border-slate-200 bg-white shadow-2xl data-[open]:flex xl:inset-x-auto xl:bottom-auto xl:right-6 xl:top-28 xl:z-30 xl:flex xl:max-h-[calc(100vh-9rem)] xl:w-[300px] xl:rounded-2xl xl:shadow-lg"
  aria-label="Table of contents"
>
  <div class="flex items-center gap-2.5 border-b border-slate-100 px-4 py-3.5">
    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
      ><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg
    >
    <span class="line-clamp-1 flex-1 text-[14px] font-bold text-slate-900">{storyTitle}</span>
    <button type="button" data-toc-close class="text-xl leading-none text-zinc-400 xl:hidden" aria-label="Close">×</button>
  </div>
  <div class="flex items-center justify-between border-b border-slate-100 px-4 py-2.5 text-[11px] font-medium uppercase tracking-wider text-slate-400">
    <span>Table of contents</span>
    <span>{chapters.length}</span>
  </div>
  <ol class="overflow-y-auto overscroll-contain">
    {
      chapters.map((c) => {
        const active = c.data.number === current;
        return (
          <li class="border-b border-slate-100 last:border-0">
            <a
              href={chapterUrl(slug, c.data.number)}
              aria-current={active ? 'page' : undefined}
              data-active={active || undefined}
              class:list={['flex items-center gap-3 px-4 py-2.5 text-[13px] hover:bg-blue-50', active ? 'bg-blue-50 font-medium text-blue-600' : 'text-slate-700']}
            >
              <span
                class:list={[
                  'flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[12px] font-semibold tabular-nums',
                  active ? 'bg-blue-600 text-white' : 'bg-blue-50 text-blue-600',
                ]}
              >
                {pad(c.data.number)}
              </span>
              <span class="line-clamp-1">
                Chapter {c.data.number} - {c.data.title}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</aside>

<button
  type="button"
  data-toc-open
  class="fixed right-4 top-1/2 z-40 flex -translate-y-1/2 items-center gap-2 rounded-full bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-lg xl:hidden"
  aria-controls="chapter-toc"
>
  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h12M4 18h8"></path></svg>
  Chapters
</button>
<div data-toc-backdrop class="fixed inset-0 z-40 hidden bg-black/30 xl:!hidden"></div>

<script>
  const toc = document.getElementById('chapter-toc')!;
  const backdrop = document.querySelector<HTMLElement>('[data-toc-backdrop]')!;
  const setOpen = (open: boolean) => {
    toc.toggleAttribute('data-open', open);
    backdrop.classList.toggle('hidden', !open);
    if (open) toc.querySelector('[data-active]')?.scrollIntoView({ block: 'center' });
  };
  document.querySelector('[data-toc-open]')?.addEventListener('click', () => setOpen(true));
  document.querySelector('[data-toc-close]')?.addEventListener('click', () => setOpen(false));
  backdrop.addEventListener('click', () => setOpen(false));
  // Desktop: cuộn mục lục tới chương hiện tại
  const active = toc.querySelector<HTMLElement>('[data-active]');
  const list = toc.querySelector('ol')!;
  if (active && matchMedia('(min-width: 1280px)').matches) list.scrollTop = active.offsetTop - list.clientHeight / 2;
</script>
