---
// Hiển thị "Continue reading" từ lịch sử đọc lưu trong localStorage (render phía client).
---

<section id="continue-reading" class="mb-8 hidden" aria-labelledby="continue-heading">
  <h2 id="continue-heading" class="mb-3 text-sm font-bold uppercase tracking-[0.08em] text-slate-900">Continue reading</h2>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-list></ul>
</section>

<script>
  type Entry = { slug: string; title: string; chapter: number; total: number; url: string; at: number };
  try {
    const history: Entry[] = JSON.parse(localStorage.getItem('reading-history') || '[]');
    const section = document.getElementById('continue-reading')!;
    const list = section.querySelector('[data-list]')!;
    if (history.length) {
      for (const h of history.slice(0, 3)) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = h.url;
        a.className = 'block rounded-xl border border-zinc-200 bg-white p-3 hover:border-blue-300';
        const title = document.createElement('div');
        title.className = 'line-clamp-1 text-sm font-semibold text-slate-900';
        title.textContent = h.title;
        const meta = document.createElement('div');
        meta.className = 'mt-1 text-xs text-accent';
        meta.textContent = `Chapter ${h.chapter} / ${h.total}`;
        const bar = document.createElement('div');
        bar.className = 'mt-2 h-1 rounded bg-zinc-100';
        const fill = document.createElement('div');
        fill.className = 'h-1 rounded bg-accent';
        fill.style.width = `${Math.round((h.chapter / h.total) * 100)}%`;
        bar.appendChild(fill);
        a.append(title, meta, bar);
        li.appendChild(a);
        list.appendChild(li);
      }
      section.classList.remove('hidden');
    }
  } catch {}
</script>
